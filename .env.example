# ===========================================
# 环境变量示例 - 复制为 .env 后填写真实值
# 本地开发与生产共用同一份 LLM API Key
# ===========================================

# 运行环境: development / production / dgx
APP_ENV=dgx

# ---- LLM 配置 ----
# DGX 本地 vLLM 可留空; 云端百炼填 sk-xxx
QWEN_API_KEY=
# 本地: local | 云端: qwen
LLM_PROVIDER=local
# Moonshot API Key (备选, 可留空)
MOONSHOT_API_KEY=

# ---- 数据库 ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=audit
POSTGRES_USER=audit
POSTGRES_PASSWORD=audit_dev_pwd

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- MinIO 对象存储 ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=audit_dev
MINIO_SECRET_KEY=audit_dev_secret
MINIO_BUCKET_DEV=audit-dev
MINIO_BUCKET_PROD=audit-prod

# ---- Webhook 签名密钥 (可选) ----
WEBHOOK_SECRET=change-me-in-production

# ---- API 鉴权 (可选) ----
API_KEY=

# ---- iframe 嵌入页鉴权（生产必须设置为两个不同的强随机值） ----
# 合作方后端仅使用 EMBED_API_KEY 换取短期任务 Token，不得放入浏览器。
EMBED_API_KEY=
# 至少 32 字符，仅服务端保存，用于签名短期 Token。
EMBED_TOKEN_SECRET=
# 可选：固定返回的公网地址，例如 http://example.com:25740
EMBED_PUBLIC_BASE_URL=
